@model LaboratorioMVC.Models.EquipoFiltroViewModel

@{
    ViewData["Title"] = "Inventario de Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inventario de Equipos de Laboratorio</h2>
    <a asp-action="Create" class="btn btn-success">+ Nuevo Equipo</a>
</div>

<!-- Filtros combinados de búsqueda -->
<div class="card mb-4 bg-light shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold">Buscar por nombre o código</label>
                <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Ej. LAP-001 o Dell" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Filtrar por Categoría</label>
                <select name="categoriaId" asp-items="Model.Categorias" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos --</option>
                    <option value="Disponible" selected="@(Model.Estado == "Disponible")">Disponible</option>
                    <option value="Prestado" selected="@(Model.Estado == "Prestado")">Prestado</option>
                    <option value="EnMantenimiento" selected="@(Model.Estado == "EnMantenimiento")">En Mantenimiento</option>
                    <option value="DeBaja" selected="@(Model.Estado == "DeBaja")">De Baja</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-dark w-100">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Barra de información de registros -->
<div class="d-flex justify-content-between align-items-center mb-2 text-muted">
    <small>Mostrando <strong>@Model.Equipos.Count()</strong> de <strong>@Model.TotalRegistros</strong> registros totales (Página @Model.PaginaActual de @Model.TotalPaginas)</small>
</div>

<!-- Tabla de equipos -->
<table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nombre del Equipo</th>
            <th>Marca / Modelo</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th class="text-center" style="width: 170px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Equipos != null && Model.Equipos.Any())
        {
            foreach (var item in Model.Equipos)
            {
                <tr>
                    <td class="fw-bold">@item.CodigoInventario</td>
                    <td>@item.Nombre</td>
                    <td>@($"{item.Marca ?? "-"} / {item.Modelo ?? "-"}")</td>
                    <td><span class="badge bg-secondary">@item.CategoriaNombre</span></td>
                    <td>
                        @switch (item.Estado)
                        {
                            case "Disponible":
                                <span class="badge bg-success">Disponible</span>
                                break;
                            case "Prestado":
                                <span class="badge bg-warning text-dark">Prestado</span>
                                break;
                            case "EnMantenimiento":
                                <span class="badge bg-info text-dark">Mantenimiento</span>
                                break;
                            default:
                                <span class="badge bg-danger">@item.Estado</span>
                                break;
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este equipo?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No se encontraron equipos que coincidan con los criterios.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Controles de navegación de paginación -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de equipos" class="mt-4">
        <ul class="pagination justify-content-center">
            <!-- Botón Anterior -->
            <li class="page-item @(Model.TienePaginaAnterior ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(Model.PaginaActual - 1)"
                   asp-route-buscar="@Model.Buscar"
                   asp-route-categoriaId="@Model.CategoriaId"
                   asp-route-estado="@Model.Estado">
                    &laquo; Anterior
                </a>
            </li>

            <!-- Números de página -->
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i"
                       asp-route-buscar="@Model.Buscar"
                       asp-route-categoriaId="@Model.CategoriaId"
                       asp-route-estado="@Model.Estado">
                        @i
                    </a>
                </li>
            }

            <!-- Botón Siguiente -->
            <li class="page-item @(Model.TienePaginaSiguiente ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(Model.PaginaActual + 1)"
                   asp-route-buscar="@Model.Buscar"
                   asp-route-categoriaId="@Model.CategoriaId"
                   asp-route-estado="@Model.Estado">
                    Siguiente &raquo;
                </a>
            </li>
        </ul>
    </nav>
}