@model LaboratorioMVC.Models.HistorialUsuarioViewModel

@{
    ViewData["Title"] = "Historial de Préstamos por Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Historial de Préstamos por Usuario</h2>
        <p class="text-muted mb-0">Consulta la ficha de préstamos activos, devueltos y observaciones por estudiante o docente.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">&laquo; Volver al Tablero General</a>
</div>

<!-- Buscador de usuario -->
<div class="card bg-light shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Historial" class="row g-3 align-items-end">
            <div class="col-md-9">
                <label class="form-label fw-bold">Buscar por Carnet, Usuario o Nombre Completo:</label>
                <input type="text" name="termino" value="@Model.TerminoBusqueda" class="form-control" placeholder="Ej. EST-001 o Carlos Reyes" required />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Consultar Historial</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Atención:</strong> @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.RealizoBusqueda && string.IsNullOrWhiteSpace(Model.MensajeError))
{
    <!-- Ficha del Usuario -->
    <div class="card border-primary shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-5">Ficha del Usuario</span>
            <span class="badge bg-light text-dark">Rol: @Model.Rol</span>
        </div>
        <div class="card-body">
            <div class="row text-center text-md-start">
                <div class="col-md-4 mb-2">
                    <span class="text-muted d-block">Carnet / Username:</span>
                    <strong class="fs-5">@Model.Carnet</strong>
                </div>
                <div class="col-md-4 mb-2">
                    <span class="text-muted d-block">Nombre Completo:</span>
                    <strong class="fs-5">@Model.NombreCompleto</strong>
                </div>
                <div class="col-md-4 mb-2">
                    <span class="text-muted d-block">Resumen de Préstamos:</span>
                    <span class="badge bg-secondary">Total: @Model.TotalSolicitados</span>
                    <span class="badge bg-warning text-dark">Activos: @Model.TotalActivos</span>
                    <span class="badge bg-success">Devueltos: @Model.TotalDevueltos</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Detallada -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">
            Detalle de Préstamos Registrados
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Equipo</th>
                        <th>Categoría</th>
                        <th>Fecha Préstamo</th>
                        <th>Fecha Límite</th>
                        <th>Fecha Devolución</th>
                        <th>Estado</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Prestamos != null && Model.Prestamos.Any())
                    {
                        foreach (var item in Model.Prestamos)
                        {
                            <tr>
                                <td>
                                    <strong>@item.NombreEquipo</strong><br />
                                    <small class="badge bg-light text-dark border">@item.CodigoInventario</small>
                                </td>
                                <td><span class="badge bg-secondary">@item.Categoria</span></td>
                                <td>@item.FechaPrestamo.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@(item.FechaDevolucion.HasValue ? item.FechaDevolucion.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>
                                    @if (item.Estado == "Activo")
                                    {
                                        <span class="badge bg-warning text-dark">Activo</span>
                                    }
                                    else if (item.Estado == "Devuelto")
                                    {
                                        <span class="badge bg-success">Devuelto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.Estado</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Observaciones) ? "Sin observaciones" : item.Observaciones)</small>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Este usuario no cuenta con historial de préstamos.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}