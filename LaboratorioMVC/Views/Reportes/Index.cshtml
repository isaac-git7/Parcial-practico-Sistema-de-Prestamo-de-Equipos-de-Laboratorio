@model LaboratorioMVC.Models.TableroReportesViewModel

@{
    ViewData["Title"] = "Panel de Reportes y Monitoreo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Tablero de Monitoreo del Laboratorio</h2>
        <p class="text-muted mb-0">Métricas operativas del inventario y control de devoluciones fuera de plazo.</p>
    </div>
    <a asp-action="Historial" class="btn btn-primary">🔍 Consultar Historial por Usuario</a>
</div>

<!-- Tarjetas KPI -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card bg-primary text-white text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">Total Equipos</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.TotalEquipos</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-success text-white text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">Disponibles</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.EquiposDisponibles</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-warning text-dark text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">Prestados</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.EquiposPrestados</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-secondary text-white text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">Mantenimiento</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.EquiposEnMantenimiento</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-info text-white text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">Préstamos Activos</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.TotalPrestamosActivos</h2>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-danger text-white text-center p-3 shadow-sm">
            <h6 class="text-uppercase mb-1">En Mora</h6>
            <h2 class="fw-bold mb-0">@Model.Resumen.PrestamosVencidos</h2>
        </div>
    </div>
</div>

<div class="row">
    <!-- Tabla de mora -->
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-danger h-100">
            <div class="card-header bg-danger text-white fw-bold">
                ⚠️ Préstamos Vencidos (Acción Inmediata)
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Equipo</th>
                            <th>Usuario / Carnet</th>
                            <th>Límite</th>
                            <th class="text-center">Retraso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Vencidos != null && Model.Vencidos.Any())
                        {
                            foreach (var item in Model.Vencidos)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold">@item.CodigoInventario</span><br />
                                        <small class="text-muted">@item.NombreEquipo</small>
                                    </td>
                                    <td>
                                        @item.NombreUsuario<br />
                                        <small class="badge bg-light text-dark border">@item.CarnetOUsuario</small>
                                    </td>
                                    <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger">@item.DiasRetraso días</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-success py-4">
                                    ✓ No existen préstamos con fecha vencida en este momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top 5 Equipos -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-header bg-primary text-white fw-bold">
                🏆 Top 5: Equipos Más Solicitados
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Equipo</th>
                            <th>Categoría</th>
                            <th class="text-center">Total Préstamos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopEquipos != null && Model.TopEquipos.Any())
                        {
                            foreach (var eq in Model.TopEquipos)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold">@eq.NombreEquipo</span><br />
                                        <small class="text-muted">@eq.CodigoInventario</small>
                                    </td>
                                    <td><span class="badge bg-secondary">@eq.CategoriaNombre</span></td>
                                    <td class="text-center fw-bold">@eq.TotalPrestamos</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    No hay préstamos suficientes para calcular el ranking.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>